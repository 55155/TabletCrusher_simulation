<mujoco model="Crusher_al">
  <compiler angle="radian"/>

  <!-- ── 재질: 알루미늄 (density 2700 kg/m³, steel 7800 kg/m³, ratio=0.34615) ── -->

  <asset>
    <mesh name="base_link"       content_type="model/stl" file="base_link.stl"       scale="0.001 0.001 0.001"/>
    <mesh name="braket1_1"       content_type="model/stl" file="braket1_1.stl"       scale="0.001 0.001 0.001"/>
    <mesh name="braket2_1"       content_type="model/stl" file="braket2_1.stl"       scale="0.001 0.001 0.001"/>
    <mesh name="motor_1"         content_type="model/stl" file="motor_1.stl"         scale="0.001 0.001 0.001"/>
    <mesh name="motor_shaft_1"   content_type="model/stl" file="motor_shaft_1.stl"   scale="0.001 0.001 0.001"/>
    <mesh name="Link1_1"         content_type="model/stl" file="Link1_1.stl"         scale="0.001 0.001 0.001"/>
    <mesh name="Link2_1"         content_type="model/stl" file="Link2_1.stl"         scale="0.001 0.001 0.001"/>
    <mesh name="Link3_1"         content_type="model/stl" file="Link3_1.stl"         scale="0.001 0.001 0.001"/>
    <mesh name="slider_jig_1"    content_type="model/stl" file="slider_jig_1.stl"    scale="0.001 0.001 0.001"/>
    <mesh name="slider_1"        content_type="model/stl" file="slider_1.stl"        scale="0.001 0.001 0.001"/>
    <mesh name="Impact_plate_1"  content_type="model/stl" file="Impact_plate_1.stl"  scale="0.001 0.001 0.001"/>
    <mesh name="shaft_1"         content_type="model/stl" file="shaft_1.stl"         scale="0.001 0.001 0.001"/>
    <mesh name="Wall_1"          content_type="model/stl" file="Wall_1.stl"          scale="0.001 0.001 0.001"/>
  </asset>

  <!-- 알루미늄 색상: 밝은 은색 -->
  <worldbody>
    <geom type="mesh" rgba="0.85 0.85 0.90 1" mesh="base_link"/>
    <geom type="mesh" rgba="0.85 0.85 0.90 1" mesh="braket1_1"/>
    <geom type="mesh" contype="0" conaffinity="0" rgba="0.85 0.85 0.90 1" mesh="braket2_1"/>
    <geom type="mesh" rgba="0.85 0.85 0.90 1" mesh="motor_1"/>
    <geom type="mesh" rgba="0.85 0.85 0.90 1" mesh="slider_jig_1"/>
    <geom type="mesh" contype="0" conaffinity="0" rgba="0.85 0.85 0.90 1" mesh="slider_1"/>
    <geom name="Wall_1" pos="0 -0.00 0" type="mesh" rgba="0.85 0.85 0.90 1" mesh="Wall_1"/>
    <site name="wall_marker" pos="-0.06 0.35947925 0.03555163" type="sphere" size="0.005" rgba="1 0 0 1"/>

    <!-- motor_shaft_1: steel 0.0393299 kg → Al 0.013614 kg -->
    <body name="motor_shaft_1" pos="-0.0625 0.085 0.05">
      <inertial pos="0.014137 0.00923579 0"
                quat="0.510125 0.489666 -0.510125 0.489666"
                mass="0.013614"
                diaginertia="1.84839e-06 1.82861e-06 7.12304e-07"/>
      <!-- Revolute 10: damping=1.55 (14 RPM 목표 속도 유지) -->
      <joint name="Revolute 10" pos="0 0 0" axis="1 0 0" damping="1.55"/>
      <geom pos="0.0625 -0.085 -0.05" quat="1 0 0 0" contype="0" conaffinity="0" type="mesh" rgba="0.85 0.85 0.90 1" mesh="motor_shaft_1"/>
      <geom pos="0.0625 -0.085 -0.05" quat="1 0 0 0" type="mesh" rgba="0.85 0.85 0.90 1" mesh="Link1_1"/>

      <!-- Link2_1: steel 0.167105 kg → Al 0.057843 kg -->
      <body name="Link2_1" pos="0.0195 0.02 0">
        <inertial pos="0.005 0.047 0"
                  quat="0.707107 0.707107 0 0"
                  mass="0.057843"
                  diaginertia="5.74609e-05 5.57302e-05 2.42308e-06"/>
        <joint name="Revolute 12" pos="0 0 0" axis="-1 0 0" damping="0.1"/>
        <geom pos="0.043 -0.105 -0.05" quat="1 0 0 0" type="mesh" rgba="0.85 0.85 0.90 1" mesh="Link2_1"/>

        <!-- Link3_1: steel 0.0450181 kg → Al 0.015583 kg -->
        <body name="Link3_1" pos="0 0.094 0">
          <inertial pos="-0.005 0.0112742 0"
                    quat="0.707107 0.707107 0 0"
                    mass="0.015583"
                    diaginertia="1.73077e-06 1.38462e-06 6.92308e-07"/>
          <joint name="Revolute 13" pos="0 0 0" axis="-1 0 0"/>
          <geom pos="0.043 -0.199 -0.05" quat="1 0 0 0" type="mesh" rgba="0.85 0.85 0.90 1" mesh="Link3_1"/>
        </body>
      </body>
    </body>

    <!-- shaft_1 (Impact plate): steel 0.235246 kg → Al 0.081434 kg -->
    <body name="shaft_1" pos="-0.0475 0.2365 0.05">
      <inertial pos="-0.0746639 0.00986097 0"
                quat="0.416653 0.416653 0.571315 0.571315"
                mass="0.081434"
                diaginertia="1.28426e-04 1.26546e-04 2.68509e-05"/>
      <joint name="Slider 21" pos="0 0 0" axis="0 -1 0" type="slide" actuatorfrcrange="-100 100"/>
      <geom pos="0.0475 -0.2365 -0.05" quat="1 0 0 0" type="mesh" rgba="0.85 0.85 0.90 1" mesh="shaft_1"/>
      <!-- Impact_plate: solref 강성 증가로 ~400 N 접촉력 목표 -->
      <geom pos="0.0475 -0.2365 -0.05" quat="1 0 0 0" type="mesh" rgba="0.85 0.85 0.90 1"
            mesh="Impact_plate_1" solref="0.022 1" solimp="0.99 0.999 0.0001 0.5 2"/>
    </body>
  </worldbody>

  <equality>
    <weld body1="Link3_1" body2="shaft_1" solref="0.001 1" solimp="0.99 0.999 0.001"/>
  </equality>

  <keyframe>
    <key name="initial" qpos="-1.57079633 -1.78 0.213 0.0221"/>
  </keyframe>

  <actuator>
    <!-- gear ratio 1:229 (알루미늄 버전 동일) -->
    <motor name="crank_motor" joint="Revolute 10" ctrlrange="-100 100" gear="229"/>
  </actuator>
</mujoco>
